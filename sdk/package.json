{
  "name": "@graveyield/sdk",
  "version": "0.2.0",
  "description": "TypeScript salvor SDK for GraveYield Protocol — derelict-pool detection, certify-and-salvage flow, claim helpers. Phase 8 complete: evaluatePool, recordLaunchPrice, phase1/phase2, snapshotLpHolders, buildMerkleTree, certifyAndSalvage, claimLpProceeds.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GraveYield/graveyield-protocol.git",
    "directory": "sdk"
  },
  "homepage": "https://graveyield.xyz",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "node --test --import tsx/esm --test-reporter=spec --test-name-pattern='.*' 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-token": "^0.4.6",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
