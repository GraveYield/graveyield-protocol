{
  "name": "@graveyield/indexer",
  "version": "0.2.0",
  "description": "Off-chain GraveScanner v2 indexer — discovers candidate derelict pools across Solana AMMs (Raydium V4 in v1) and surfaces them to salvors. Phase 9 complete.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @graveyield/sdk build && tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test": "node --test --import tsx/esm --test-reporter=spec --test-name-pattern='.*' 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-token": "^0.4.6",
    "@graveyield/sdk": "workspace:*",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
